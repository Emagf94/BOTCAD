# ==========================================
# CONFIGURACIÓN DEL ENTORNO - BOT CAD IMPRESIONES
# ==========================================

# Puerto del servidor web (para ver el código QR y healthcheck)
PORT=3008

# Modo Headless de Chrome/Puppeteer:
# - false: Abre la ventana del navegador Chrome (ideal para Windows o pruebas locales)
# - true:  Ejecuta Chrome de manera invisible en segundo plano (ideal para servidores Linux / VPS / 24-7 sin pantalla)
HEADLESS=false

# Entorno de ejecución
NODE_ENV=production
